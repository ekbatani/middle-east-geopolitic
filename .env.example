APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret

# PostgreSQL Database Configuration
POSTGRES_USER=mei
POSTGRES_PASSWORD=mei
POSTGRES_DB=mei
DATABASE_URL=postgresql+asyncpg://mei:mei@postgres:5432/mei

# Grafana Monitoring Configuration
GRAFANA_ADMIN_PASSWORD=admin

# Supported providers: openai, openrouter, opencode_go, nvidia_build, ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=change-me
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_SECONDARY_MODEL=
MULTI_MODEL_REVIEW_SCORE_DELTA_THRESHOLD=15
MULTI_MODEL_REVIEW_AGREEMENT_TOLERANCE=5

# Authentication & Security
JWT_ISSUER=mei-platform
JWT_AUDIENCE=mei-clients
JWT_ACCESS_TOKEN_TTL_SECONDS=3600

# External API Integrations
HERMES_API_KEY=change-me
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_CHAT_ID=change-me

# Processing & Heuristics Configuration
ENTITY_RESOLUTION_AUTO_THRESHOLD=92.0
ENTITY_RESOLUTION_REVIEW_THRESHOLD=75.0
TRANSLATION_TARGET_LANGUAGE=fa
EVENT_DEDUP_WINDOW_HOURS=48
RAW_DATA_RETENTION_DAYS=180
